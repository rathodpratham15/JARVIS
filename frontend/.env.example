# Frontend dev configuration. Copy to .env and edit if your backend
# is not running on the default port (5050).

# Where Vite forwards /api/* and /socket.io/* during `pnpm dev`.
VITE_API_URL=http://localhost:5050

# Optional: Picovoice Porcupine access key for offline WASM wake word detection.
# Get a free key at https://console.picovoice.ai/
# If omitted, JARVIS falls back to the browser SpeechRecognition API.
VITE_PICOVOICE_ACCESS_KEY=
